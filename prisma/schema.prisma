generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Permissao {
  ADMIN
  ALUNO
  TECNICO
  ASSISTENTE
}

enum Sexo {
  MASCULINO
  FEMININO
  NAO_INFORMAR
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
}


enum TipoIngresso {
  SISU
  TRANSFERENCIA
  OUTRO
}

enum SituacaoSaude {
  DOENCA_CRONICA
  DOENCA_GRAVE
  DEFICIENCIA
  USO_CONTINUO_MEDICAMENTO
  OUTRA
  NAO
}

enum SituacaoViolencia {
  VIOLENCIA_DOMESTICA
  VIOLENCIA_PSICOLOGICA
  VIOLENCIA_COMUNIDADE_URBANA
  OUTRA
  NAO
}

enum AcessoTransporte {
  NAO_TENHO_ACESSO
  TRANSPORTE_PAGO_COM_DIFICULDADE
  TRANSPORTE_PAGO_SEM_DIFICULDADE
  TRANSPORTE_GRATUITO_COM_DIFICULDADE
  TRANSPORTE_GRATUITO_SEM_DIFICULDADE
}

enum IdentificacaoSituacao {
  GESTANTE
  TEM_FILHOS
  NAO
}

enum SituacaoFamiliarInstavel {
  SIM
  NAO
}

enum ProgramaSocial {
  BOLSA_FAMILIA
  BPC_LOAS
  SEGURO_SAFRA
  OUTRO
  NAO
}

enum TipoMoradia {
  PROPRIA
  ALUGADA
  CEDIDA
  REPUBLICA
  ALOJAMENTO
  OUTRO
}

enum CondicaoMoradia {
  MORA_COM_FAMILIA
  MORA_SOZINHO
  DIVIDE_ALUGUEL
  MORA_COM_AMIGOS
  OUTRO
}

enum Parentesco {
  PAI
  MAE
  IRMAO_IRMA
  AVO_AVA
  TIO_TIA
  PRIMO_PRIMA
  CONJUGE
  OUTRO
}

enum SituacaoOcupacional {
  PROPRIETARIO_SOCIO_EMPRESA
  MEI_PROFISSIONAL_LIBERAL
  TRABALHADOR_ASSALARIADO
  APOSENTADO_PENSIONISTA_BPC
  TRABALHADOR_INFORMAL_AUTONOMO
  RENDA_DE_TERCEIROS
  TRABALHADOR_RURAL
  BOLSISTA_ESTAGIARIO
  DESEMPREGADO_SEGURO_DESEMPREGO
}

enum ContribuiRendaFamiliar {
  SIM
  NAO
}

enum TipoAuxilio {
  BOLSA
  AUXILIO
}

enum StatusAlunoAuxilio {
  ATIVO
  ENCERRADO
  SUSPENSO
}

enum TipoDocumento {
  RG
  CPF
}

enum StatusDocumento {
  ATIVO
  INATIVO
}

enum StatusSolicitacao {
  RASCUNHO
  PENDENTE
  EM_ANALISE
  DEFERIDO
  INDEFERIDO
}

enum TipoResponsavel {
    PAI
    MAE
    PROPRIO
    OUTRO
}

enum IdentidadeGenero {
  MULHER_CISGENERO
  HOMEM_CISGENERO
  MULHER_TRANSGENERA
  HOMEM_TRANSGENERO
  NAO_BINARIO
  OUTRO
  NAO_INFORMAR
}

enum OrientacaoSexual {
  HETEROSEXUAL
  HOMOSSEXUAL
  BISEXUAL
  PANSEXUAL
  ASSEXUAL
  OUTRO
  NAO_INFORMAR
}

enum EtniaRaca {
  BRANCO
  PRETO
  PARDO
  AMARELO
  INDIGENA
  NAO_INFORMAR
}

enum TipoDeficiencia {
  NAO_POSSUI
  ALTAS_HABILIDADES_SUPERDOTACAO
  BAIXA_VISAO
  CEGUEIRA
  AUDITIVA
  FISICA
  INTELECTUAL
  MENTAL
  MULTIPLA
  SENSORIAL
  SINDROME_ASPERGER
  TEA
  TRANSTORNO_GLOBAL_DESENVOLVIMENTO
  OUTRA
}

model Auth {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  senha     String
  permissao Permissao

  // CAMPOS PARA RECUPERAÇÃO DE SENHA
  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  aluno       Aluno?
  funcionario Funcionario?

  @@map("auth")
}

model Aluno {
  id     Int @id @default(autoincrement())
  authId Int @unique @map("id_auth")

  nome      String
  cpf       String? @unique
  rg        String? @unique
  matricula String  @unique

  emailContato String?
  telefone     String?

  curso         String?
  turno         String?
  anoIngresso   Int?
  semestreAtual Int?

  tipoIngresso String?

  dataNasc         DateTime? @db.Date
  tipoResponsavel  TipoResponsavel?
  tipoResponsavelOutro String?
  nomeResponsavel  String?

  sexo             Sexo?
  orientacaoSexual OrientacaoSexual?
  orientacaoSexualOutro String?
  identidadeGenero IdentidadeGenero?
  identidadeGeneroOutro String?
  etniaRaca        EtniaRaca?
  estadoCivil      EstadoCivil?
  tipoDeficiencia  TipoDeficiencia?
  tipoDeficienciaOutro String?

  etapaCadastro    Int? 
  cadastroFinalizado Boolean @default(false)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  enderecos         Endereco?
  membrosFamiliares MembroFamiliar[]
  despesa           Despesa?
  solicitacoes      Solicitacao[]
  documentos        Documento[]
  auxilios          AlunoAuxilio[]
  situacaoVida      SituacaoVida?

  @@map("aluno")
}

model Funcionario {
  id     Int @id @default(autoincrement())
  authId Int @unique @map("id_auth")

  nome  String
  siape Int    @unique

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  auth         Auth          @relation(fields: [authId], references: [id], onDelete: Cascade)
  solicitacoes Solicitacao[]

  @@map("funcionarios")
}

model Endereco {
  id      Int @id @default(autoincrement())
  alunoId Int @unique @map("id_aluno")

  tipoMoradia      TipoMoradia
  tipoMoradiaOutro String?

  logradouro       String
  numero           String   @map("numero_ap")
  complemento      String?
  
  origemFamilia        String
  
  condicaoMoradia      CondicaoMoradia
  condicaoMoradiaOutro String?

//   cep       String? //deixar comentado para casos futuros
  bairro    String
  municipio String
  estado    String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@map("endereco")
}

model MembroFamiliar {
  id      Int @id @default(autoincrement())
  alunoId Int @map("id_aluno")

  nomeCompleto    String     @map("nome_completo")
  parentesco      Parentesco
  parentescoOutro String?    @map("parentesco_outro")
  dataNascimento  DateTime   @map("data_nascimento")

  situacaoOcupacional    SituacaoOcupacional    @map("situacao_ocupacional")
  rendaIndividualMensal  Float                  @default(0) @map("renda_individual_mensal")
  contribuiRendaFamiliar ContribuiRendaFamiliar @map("contribui_renda_familiar")

  isEstudante Boolean @default(false) @map("is_estudante")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@map("membros_familiares")
}

model Despesa {
  id      Int @id @default(autoincrement())
  alunoId Int @unique @map("id_aluno")

  moradia     Float @default(0)
  transporte  Float @default(0)
  alimentacao Float @default(0)
  saude       Float @default(0)
  educacao    Float @default(0)
  outras      Float @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@map("despesas")
}

model SituacaoVida {
  id      Int @id @default(autoincrement())
  alunoId Int @unique @map("id_aluno")

  situacoesSaude     SituacaoSaude[] @map("situacoes_saude")
  situacaoSaudeOutra String?         @map("situacao_saude_outra")

  situacoesViolencia     SituacaoViolencia[] @map("situacoes_violencia")
  situacaoViolenciaOutra String?             @map("situacao_violencia_outra")

  acessoTransporte AcessoTransporte? @map("acesso_transporte")

  identificacaoSituacao IdentificacaoSituacao? @map("identificacao_situacao")

  situacaoFamiliarInstavel SituacaoFamiliarInstavel? @map("situacao_familiar_instavel")

  programaSocial      ProgramaSocial? @map("programa_social")
  programaSocialOutro String?         @map("programa_social_outro")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@map("situacoes_vida")
}

model Auxilio {
  id Int @id @default(autoincrement())

  nome        String
  tipoAuxilio TipoAuxilio
  descricao   String?

  alunos       AlunoAuxilio[]
  solicitacoes Solicitacao[]

  @@map("auxilios")
}

model AlunoAuxilio {
  id Int @id @default(autoincrement())

  alunoId   Int @map("id_aluno")
  auxilioId Int @map("id_auxilio")

  dataInicio DateTime
  dataFim    DateTime?

  status     StatusAlunoAuxilio
  observacao String?

  createdAt DateTime @default(now()) @map("created_at")

  aluno   Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  auxilio Auxilio @relation(fields: [auxilioId], references: [id], onDelete: Cascade)

  @@unique([alunoId, auxilioId])
  @@index([auxilioId])
  @@map("alunos_auxilios")
}

model Solicitacao {
  id Int @id @default(autoincrement())

  alunoId       Int  @map("id_aluno")
  auxilioId     Int  @map("id_auxilio")
  funcionarioId Int? @map("id_funcionario")

  status StatusSolicitacao @default(PENDENTE)

  dataInicio DateTime?
  dataFinal  DateTime? @map("data_final_analise")

  observacao String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  aluno       Aluno        @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  auxilio     Auxilio      @relation(fields: [auxilioId], references: [id])
  funcionario Funcionario? @relation(fields: [funcionarioId], references: [id])

  documentos DocumentoSolicitacao[]

  @@index([alunoId])
  @@index([auxilioId])
  @@index([funcionarioId])
  @@map("solicitacoes")
}

model Documento {
  id Int @id @default(autoincrement())

  alunoId Int @map("id_aluno")

  caminho String
  tipo    TipoDocumento @map("tipo_documento")

  versao Int
  status StatusDocumento
  hash   String

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  aluno        Aluno                  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  solicitacoes DocumentoSolicitacao[]

  @@index([alunoId])
  @@map("documentos")
}

model DocumentoSolicitacao {
  solicitacaoId Int @map("id_solicitacao")
  documentoId   Int @map("id_documento")

  observacao String?
  createdAt  DateTime @default(now()) @map("created_at")

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  documento   Documento   @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@id([solicitacaoId, documentoId])
  @@index([documentoId])
  @@map("documentos_solicitacoes")
}
