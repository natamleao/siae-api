generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Permissao {
  ALUNO
  TECNICO
  ASSISTENTE
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMAR
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
}

enum TipoMoradia {
  PROPRIA
  ALUGADA
  CEDIDA
  REPUBLICA
  OUTRO
}

enum TipoIngresso {
  SISU
  TRANSFERENCIA
  OUTRO
}

enum SituacaoSaude {
  doencasGraves
  cronicas
  deficiencia
  usomedicacaocontinua
}

enum Parentesco {
  pai
  mae
  irmaoIrma
  avos
  tioTia
  primoPrima
  conjuge
  outro
}

enum SituacaoOcupacional {
  propietarioEmpresa
  microempreendedorIndividual
  assalariado
  aposentadoPensionista
  informalAutonomo
  pensaoAlimenticia
  atividadeRural
  bolsistaEstagiario
  desempregado
}

model Auth {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  senha      String
  permissao  Permissao
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime?  @map("updated_at")

  aluno      Aluno?
  funcionario Funcionario?

  @@map("auth")
}

model Aluno {
  id                 Int                     @id @default(autoincrement())
  idAuth             Int                     @unique @map("id_auth")
  nome               String
  cpf                String                  @unique
  emailContato       String
  curso              String
  matricula          Int                     @unique
  turno              String
  anoIngresso        Int
  semestreAtual      Int
  telefone           String
  tipoIngresso       String
  rg                 String                  @unique
  dataNasc           DateTime
  sexo               String
  orientacaoSexual   String
  identidadeGenero   String
  etniaRaca          String
  estadoCivil        String
  deficiencia        String
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime?               @map("updated_at")

  enderecos          Endereco[]
  composicoes        ComposicaoParentesco[]

  @@map("aluno")
}

model Endereco {
  id                 Int        @id @default(autoincrement())
  idAluno            Int        @map("id_aluno")
  tipoMoradia        TipoMoradia
  logradouro         String
  numeroAp           String
  complemento        String
  cep                String
  bairro             String
  municipio          String
  estado             String
  municipioFamilia   String
  condicaoAtual      String
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime?  @map("updated_at")

  aluno              Aluno      @relation(fields: [idAluno], references: [id], onDelete: Cascade)

  @@map("endereco")
}

model Parente {
  id                    Int        @id @default(autoincrement())
  nome                  String
  parentesco            Parentesco
  dataNasc              DateTime
  ocupacao              Ocupacao
  rendaIndividual       String
  contribuicaoFamilia   String
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime?  @map("updated_at")

  composicoes           ComposicaoParentesco[]

  @@map("parente")
}

model ComposicaoParentesco {
  id         Int      @id @default(autoincrement())
  idAluno    Int      @map("id_aluno")
  idParente  Int      @map("id_parente")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  aluno      Aluno   @relation(fields: [idAluno], references: [id], onDelete: Cascade)
  parente    Parente @relation(fields: [idParente], references: [id], onDelete: Cascade)

  @@map("composicao_parentesca")
}
