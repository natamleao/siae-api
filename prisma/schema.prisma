generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Permissao {
  ALUNO
  TECNICO
  ASSISTENTE
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
  NAO_INFORMAR
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
}

enum TipoMoradia {
  PROPRIA
  ALUGADA
  CEDIDA
  REPUBLICA
  OUTRO
}

enum TipoIngresso {
  SISU
  TRANSFERENCIA
  OUTRO
}

model Usuario {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  senha     String
  permissao Permissao  @default(ALUNO)
  
  matricula Int?       @unique 
  siape     Int?       @unique
  
  resetToken        String?
  resetTokenExpiry  DateTime?
  
  solicitacoes Solicitacao[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("usuarios")
  @@index([permissao])
}

model Solicitacao {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  formularioId  Int      @unique
  
  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  formulario Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("solicitacoes")
}

model Formulario {
  id                 Int      @id @default(autoincrement())
  nomeCompleto       String
  cpf                String   @unique
  rg                 String
  dataNascimento     DateTime
  nomeResponsavel    String?
  sexo               Sexo
  orientacaoSexual   String?
  identidadeGenero   String?
  etniaRaca          String?
  estadoCivil        EstadoCivil
  deficiencia        String?
  telefone           String
  email              String
  
  tipoMoradia        TipoMoradia
  logradouro         String
  numeroAp           String
  complemento        String?
  bairro             String
  municipio          String
  estado             String
  origemFamilia      String?
  moradiaAtual       String?
  
  matricula          Int
  curso              String
  turno              String
  tipoIngresso       TipoIngresso
  recebeAux          Boolean  @default(false)
  tipoAuxRecebido    String?
  
  solicitacao Solicitacao?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("formularios")
}