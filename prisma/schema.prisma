generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Permissao {
  ADMIN
  ALUNO
  TECNICO
  ASSISTENTE
}

enum Sexo {
  MASCULINO
  FEMININO
  NAO_INFORMAR
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
}


enum TipoIngresso {
  SISU
  TRANSFERENCIA
  OUTRO
}

enum SituacaoSaude {
  doencasGraves
  cronicas
  deficiencia
  usomedicacaocontinua
}


enum SituacaoOcupacional {
  propietarioEmpresa
  microempreendedorIndividual
  assalariado
  aposentadoPensionista
  informalAutonomo
  pensaoAlimenticia
  atividadeRural
  bolsistaEstagiario
  desempregado
}


enum TipoMoradia {
  PROPRIA
  ALUGADA
  CEDIDA
  REPUBLICA
  ALOJAMENTO
  OUTRO
}

enum Parentesco {
  PAI
  MAE
  IRMAO
  IRMA
  AVÔ
  AVÓ
  TIO
  TIA
  PRIMO
  PRIMA
  CONJUGE
  OUTRO
}

enum Ocupacao {
  PROPRIETARIO_EMPRESA
  MICROEMPREENDEDOR_INDIVIDUAL
  ASSALARIADO
  APOSENTADO_PENSIONISTA
  INFORMAL_AUTONOMO
  PENSAO_ALIMENTICIA
  ATIVIDADE_RURAL
  BOLSISTA_ESTAGIARIO
  DESEMPREGADO
}

enum TipoAuxilio {
    BOLSA
    AUXILIO
}

enum StatusAlunoAuxilio {
    ATIVO
    ENCERRADO
    SUSPENSO
}

enum TipoDocumento {
    RG
    CPF
}

enum StatusDocumento {
    ATIVO
    INATIVO
}

enum StatusSolicitacao {
    PENDENTE
    EM_ANALISE
    DEFERIDO
    INDEFERIDO
}

enum TipoResponsavel {
    PAI
    MAE
    PROPRIO
    OUTRO
}

enum IdentidadeGenero {
  MULHER_CISGENERO
  HOMEM_CISGENERO
  MULHER_TRANSGENERA
  HOMEM_TRANSGENERO
  NAO_BINARIO
  OUTRO
  NAO_INFORMAR
}

enum OrientacaoSexual {
  HETEROSEXUAL
  HOMOSSEXUAL
  BISEXUAL
  PANSEXUAL
  ASSEXUAL
  OUTRO
  NAO_INFORMAR
}

enum EtniaRaca {
  BRANCO
  PRETO
  PARDO
  AMARELO
  INDIGENA
  NAO_INFORMAR
}

enum TipoDeficiencia {
  NAO_POSSUI
  ALTAS_HABILIDADES_SUPERDOTACAO
  BAIXA_VISAO
  CEGUEIRA
  AUDITIVA
  FISICA
  INTELECTUAL
  MENTAL
  MULTIPLA
  SENSORIAL
  SINDROME_ASPERGER
  TEA
  TRANSTORNO_GLOBAL_DESENVOLVIMENTO
  OUTRA
}

model Auth {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  senha       String
  permissao   Permissao
  // CAMPOS PARA RECUPERAÇÃO DE SENHA
  resetToken      String?  
  resetTokenExpiry DateTime?

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime?  @map("updated_at")

  aluno       Aluno?
  funcionario Funcionario?

  @@map("auth")
}

model Aluno {
  id               Int      @id @default(autoincrement())
  authId           Int      @unique @map("id_auth")

  nome             String
  cpf              String?   @unique
  rg               String?   @unique
  matricula        String    @unique

  emailContato     String?
  telefone         String?

  curso            String?
  turno            String?
  anoIngresso      Int?
  semestreAtual    Int?

  tipoIngresso     String?

  dataNasc         DateTime? @db.Date
  tipoResponsavel  TipoResponsavel?
  tipoResponsavelOutro String?
  nomeResponsavel  String?

  sexo             Sexo?
  orientacaoSexual OrientacaoSexual?
  orientacaoSexualOutro String?
  identidadeGenero IdentidadeGenero?
  identidadeGeneroOutro String?
  etniaRaca        EtniaRaca?
  estadoCivil      EstadoCivil?
  tipoDeficiencia  TipoDeficiencia?
  tipoDeficienciaOutro String?

  etapaCadastro    Int? 
  cadastroFinalizado Boolean @default(false)

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  auth             Auth     @relation(fields: [authId], references: [id], onDelete: Cascade)

  enderecos        Endereco[]
  composicoes      ComposicaoParentesco[]
  solicitacoes     Solicitacao[]
  documentos       Documento[]
  auxilios         AlunoAuxilio[]

  @@map("aluno")
}

model Funcionario {
  id         Int      @id @default(autoincrement())
  authId     Int      @unique @map("id_auth")

  nome       String
  siape      Int      @unique

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  auth        Auth          @relation(fields: [authId], references: [id], onDelete: Cascade)
  solicitacoes Solicitacao[]

  @@map("funcionarios")
}

model Endereco {
  id               Int      @id @default(autoincrement())
  alunoId          Int      @map("id_aluno")

  tipoMoradia      TipoMoradia
  tipoMoradiaOutro String?

  logradouro       String
  numero           String   @map("numero_ap")
  complemento      String?

  cep              String
  bairro           String
  municipio        String
  estado           String

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @map("updated_at")

  aluno            Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([alunoId])
  @@map("endereco")
}

model Parente {
  id                    Int      @id @default(autoincrement())

  nome                  String
  parentesco            Parentesco
  dataNasc              DateTime

  ocupacao              Ocupacao
  rendaIndividual       Float
  contribuicaoFamilia   Boolean

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime? @map("updated_at")

  composicoes           ComposicaoParentesco[]

  @@map("parente")
}

model ComposicaoParentesco {
  alunoId    Int @map("id_aluno")
  parenteId  Int @map("id_parente")

  createdAt  DateTime @default(now()) @map("created_at")

  aluno      Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  parente    Parente @relation(fields: [parenteId], references: [id], onDelete: Cascade)

  @@id([alunoId, parenteId])
  @@index([parenteId])
  @@map("composicao_parentesca")
}

model Auxilio {
  id          Int     @id @default(autoincrement())

  nome        String
  tipoAuxilio TipoAuxilio
  descricao   String?

  alunos      AlunoAuxilio[]
  solicitacoes Solicitacao[]

  @@map("auxilios")
}

model AlunoAuxilio {
  id         Int      @id @default(autoincrement())

  alunoId    Int      @map("id_aluno")
  auxilioId  Int      @map("id_auxilio")

  dataInicio DateTime
  dataFim    DateTime?

  status     StatusAlunoAuxilio
  observacao String?

  createdAt  DateTime @default(now()) @map("created_at")

  aluno      Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  auxilio    Auxilio @relation(fields: [auxilioId], references: [id], onDelete: Cascade)

  @@unique([alunoId, auxilioId])
  @@index([auxilioId])
  @@map("alunos_auxilios")
}

model Solicitacao {
  id            Int      @id @default(autoincrement())

  alunoId       Int      @map("id_aluno")
  auxilioId     Int      @map("id_auxilio")
  funcionarioId Int?     @map("id_funcionario")

  status        StatusSolicitacao @default(PENDENTE)

  dataInicio    DateTime?
  dataFinal     DateTime? @map("data_final_analise")

  observacao    String?

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  aluno         Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  auxilio       Auxilio     @relation(fields: [auxilioId], references: [id])
  funcionario   Funcionario? @relation(fields: [funcionarioId], references: [id])

  documentos    DocumentoSolicitacao[]

  @@index([alunoId])
  @@index([auxilioId])
  @@index([funcionarioId])
  @@map("solicitacoes")
}

model Documento {
  id         Int      @id @default(autoincrement())

  alunoId    Int      @map("id_aluno")

  caminho    String
  tipo       TipoDocumento @map("tipo_documento")

  versao     Int
  status     StatusDocumento
  hash       String

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  aluno      Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  solicitacoes DocumentoSolicitacao[]

  @@index([alunoId])
  @@map("documentos")
}

model DocumentoSolicitacao {
  solicitacaoId Int @map("id_solicitacao")
  documentoId   Int @map("id_documento")

  observacao    String?
  createdAt     DateTime @default(now()) @map("created_at")

  solicitacao   Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  documento     Documento   @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@id([solicitacaoId, documentoId])
  @@index([documentoId])
  @@map("documentos_solicitacoes")
}
